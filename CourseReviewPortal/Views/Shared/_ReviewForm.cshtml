
@model CourseReviewPortal.Models.CourseReview

@using (Html.BeginForm("Create", "Review", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "",
        new { @class = "text-danger mb-3" })

    <div class="mb-3">
        @Html.LabelFor(m => m.StudentName,
            new { @class = "form-label fw-bold" })

        @Html.TextBoxFor(m => m.StudentName,
            new
                 {
                     @class = "form-control",
                  placeholder = "Enter your full name"
                 })

        @Html.ValidationMessageFor(m => m.StudentName, "",
            new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Email,
            new { @class = "form-label fw-bold" })

        @Html.TextBoxFor(m => m.Email,
            new
                 {
                     @class = "form-control",
                  placeholder = "student@example.com",
                  type = "email"
                 })

        @Html.ValidationMessageFor(m => m.Email, "",
            new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.CourseName,
            new { @class = "form-label fw-bold" })

        @Html.DropDownListFor(m => m.CourseName,
            new SelectList(new[]
            {
                "Data Science",
                "Web Development",
                "Database Management",
                "Computer Networks",
                "Artificial Intelligence"
            }),
            "-- Select a Course --",
            new { @class = "form-select" })

        @Html.ValidationMessageFor(m => m.CourseName, "",
            new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Rating,
            new { @class = "form-label fw-bold" })

        @Html.DropDownListFor(m => m.Rating,
            new SelectList(new[]
            {
                new { Value = "1", Text = "1 - Poor" },
                new { Value = "2", Text = "2 - Fair" },
                new { Value = "3", Text = "3 - Good" },
                new { Value = "4", Text = "4 - Very Good" },
                new { Value = "5", Text = "5 - Excellent" }
            }, "Value", "Text"),
            "-- Choose Rating --",
            new { @class = "form-select" })

        @Html.ValidationMessageFor(m => m.Rating, "",
            new { @class = "text-danger" })
    </div>

    <div class="mb-4">
        @Html.LabelFor(m => m.Comments,
            new { @class = "form-label fw-bold" })

        @Html.TextAreaFor(m => m.Comments,
            new
                 {
                     @class = "form-control",
                  rows = "4",
                  placeholder = "Share your learning experience..."
                 })

        @Html.ValidationMessageFor(m => m.Comments, "",
            new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-review px-4">
        Submit Review
    </button>

    @Html.ActionLink("Cancel", "Index", "Review",
        null, new { @class = "btn btn-light ms-2" })
}
