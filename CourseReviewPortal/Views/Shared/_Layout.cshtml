
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Course Review Portal</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f2f5fa;
            font-family: Arial, sans-serif;
            color: #263248;
        }

        .topbar {
            background: #17243b;
            padding: 18px 0;
        }

        .brand {
            color: white;
            font-size: 22px;
            font-weight: bold;
            text-decoration: none;
        }

        .page-content {
            min-height: 75vh;
            padding-top: 35px;
            padding-bottom: 35px;
        }

        .panel {
            background: white;
            border: 1px solid #e0e6ef;
            border-radius: 14px;
            padding: 25px;
            box-shadow: 0 5px 18px rgba(20, 35, 60, 0.06);
        }

        .btn-review {
            background: #536dfe;
            color: white;
            border: none;
        }

            .btn-review:hover {
                background: #354ee0;
                color: white;
            }

        .site-footer {
            background: #17243b;
            color: #dce4f2;
            padding: 18px;
            text-align: center;
        }

        .validation-summary-errors,
        .field-validation-error {
            color: #c62828;
        }
    </style>
</head>

<body>
    <nav class="topbar">
        <div class="container d-flex justify-content-between align-items-center">
            @Html.ActionLink("Course Review Portal", "Index", "Review",
                null, new { @class = "brand" })

            <div>
                @Html.ActionLink("Dashboard", "Index", "Review",
                    null, new { @class = "btn btn-outline-light me-2" })

                @Html.ActionLink("Write a Review", "Create", "Review",
                    null, new { @class = "btn btn-warning" })
            </div>
        </div>
    </nav>

    <main class="container page-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        Course Review Portal | Student Learning Feedback System
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
</body>
</html>
